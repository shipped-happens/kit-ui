{
  "name": "@shipped-happens/kit-ui",
  "version": "1.0.0",
  "description": "Shared UI for the Shipped Happens apps: design tokens, Tailwind theme and the small parts every app repeats",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
